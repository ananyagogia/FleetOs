/* ==========================================================================
   FleetOS Design System - Variables
   ========================================================================== */

:root {
  /* Background Colors */
  --bg-app: #080d1a;
  --bg-sidebar: #0b1326;
  --bg-surface: #111c32;
  --bg-surface-hover: #17243d;

  /* Primary Colors */
  --color-primary: #00e5ff;
  --color-primary-hover: #00b8d4;

  /* Text Colors */
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-heading: #ffffff;

  /* Status Colors */
  --status-available: #10b981;
  --status-critical: #ef4444;
  --status-warning: #f59e0b;
  --status-info: #3b82f6;

  /* Border Colors */
  --border-subtle: rgba(148, 163, 184, 0.12);
  --border-strong: rgba(148, 163, 184, 0.25);

  /* Typography */
  --font-sans: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  /* Spacing */
  --space-2xs: 4px;
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;

  /* Layout */
  --sidebar-width: 250px;
  --sidebar-collapsed-width: 72px;
  --topbar-height: 64px;

  /* Radiuses */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-full: 9999px;

  /* Shadows */
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 10px 28px rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 16px rgba(0, 229, 255, 0.25);

  /* Transitions */
  --transition-fast: 150ms ease;
  --transition-normal: 250ms ease;
  --transition-slow: 350ms cubic-bezier(0.16, 1, 0.3, 1);
}
